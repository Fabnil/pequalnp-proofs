set_option maxHeartbeats 0 in
theorem targetMatches : ∀ x : Fin 8 → Bool, edgeFunction x = deskFunction x := by
  decide +kernel

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
theorem witnessCorrect : ∀ x : Fin 8 → Bool,
    Circuit.eval ⟨witness, 21⟩ (List.ofFn x) = deskFunction x := by
