def edgeFunction (x : Fin 8 → Bool) : Bool :=
  (x 0 && x 3) || (x 0 && x 4) || (x 0 && x 5) || (x 0 && x 6) || (x 0 && x 7) || (x 1 && x 5) || (x 1 && x 6) || (x 1 && x 7) || (x 2 && x 5) || (x 2 && x 6) || (x 3 && x 4) || (x 3 && x 7) || (x 4 && x 7) || (x 5 && x 6)

def edgeList : List ℕ := [0, 3, 0, 4, 3, 4, 0, 5, 1, 5, 2, 5, 0, 6, 1, 6, 2, 6, 5, 6, 0, 7, 1, 7, 3, 7, 4, 7]

def deskFunction (x : Fin 8 → Bool) : Bool := decide (∃ i < edgeList.length / 2,
  (List.ofFn x).getD (edgeList.getD (2 * i) 0) false = true ∧
  (List.ofFn x).getD (edgeList.getD (2 * i + 1) 0) false = true)

def inputOrder : Fin 8 → Fin 8 := ![6, 7, 5, 0, 2, 1, 3, 4]

def permuted (x : Fin 8 → Bool) : Bool := edgeFunction (x ∘ inputOrder)

theorem dependsOnLast : ∃ x : Fin 8 → Bool,
    permuted (Function.update x (Fin.last 7) (!x (Fin.last 7))) ≠ permuted x := by
  refine ⟨fun i => decide (i = 1), ?_⟩
  decide +kernel

theorem nonconstantAfterDeletion : ∃ x y : Fin 7 → Bool,
    permuted (Fin.snoc x false) ≠ permuted (Fin.snoc y false) := by
  refine ⟨fun i => decide (i = 0 ∨ i = 2), fun _ => false, ?_⟩
  decide +kernel

def minorFunction (x : Fin 7 → Bool) : Bool := (x 0 && x 2) || (x 1 && x 3) || (x 0 && x 4) || (x 2 && x 4) || (x 1 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6)

set_option maxRecDepth 12000 in
theorem cofactor : (fun x : Fin 7 → Bool => permuted (Fin.snoc x false)) = minorFunction := by
  apply funext
  decide +kernel

theorem lowerBound {s : ℕ} (fit : HasCircuitSize 8 edgeFunction s) : 14 ≤ s := by
  by_contra! small
  obtain ⟨C, legal, size, eval⟩ := fit
  have capped : HasCircuitSize 8 edgeFunction (12 + 1) := ⟨C, legal, by omega, eval⟩
  have relabeled : HasCircuitSize 8 permuted (12 + 1) :=
    CircuitHelpers.PermInputs.relabel_size inputOrder edgeFunction _ capped
  have restricted := CircuitHelpers.gate_elim 7 permuted false 12
    dependsOnLast nonconstantAfterDeletion relabeled
  rw [cofactor] at restricted
  have contradiction := PEqualNP.Outside.L_meta_10648_aux.final_base 12 restricted
  omega

def witness : List Gate :=
  [⟨.or, [5, 6]⟩, ⟨.or, [0, 7]⟩, ⟨.or, [7, 8]⟩, ⟨.or, [3, 4]⟩,
   ⟨.or, [0, 1]⟩, ⟨.and, [3, 4]⟩, ⟨.and, [2, 8]⟩, ⟨.and, [11, 9]⟩,
   ⟨.and, [12, 10]⟩, ⟨.and, [5, 6]⟩, ⟨.or, [13, 14]⟩, ⟨.or, [18, 15]⟩,
   ⟨.or, [19, 16]⟩, ⟨.or, [20, 17]⟩]

theorem witnessBasis : ∀ g ∈ witness, (g.op = .and ∨ g.op = .or) ∧ g.inputs.length ≤ 2 := by
  simp [witness]

